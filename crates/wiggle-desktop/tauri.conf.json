{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tervixa Wiggle",
  "version": "1.0.0",
  "identifier": "in.tervixa.wiggle",
  "build": {
    "beforeDevCommand": "pnpm --dir apps/desktop-ui dev",
    "beforeBuildCommand": "pnpm --dir apps/desktop-ui build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../apps/desktop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tervixa Wiggle",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' http://localhost:* http://127.0.0.1:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "rpm", "appimage", "dmg", "app"],
    "icon": [],
    "copyright": "Copyright (c) 2026 Tervixa Corporation",
    "shortDescription": "Tervixa Wiggle - autonomous AI engineering agent",
    "longDescription": "Tervixa Wiggle is an autonomous AI software engineering, research and workstation agent developed by Tervixa Corporation (Tervixa Forge).",
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  }
}
